# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/syncdoc

# Redis (sessions, rate-limit store, socket.io adapter for horizontal scale)
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email (nodemailer - use an SMTP provider like Resend/SendGrid/Mailtrap in dev)
# Leave SMTP_HOST blank to run in dev-mode: emails are logged to the
# backend console instead of actually sent, so register/forgot-password/
# invite flows work immediately with zero email setup. Fill these in only
# once you have real provider credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SyncDoc <no-reply@syncdoc.app>"

# OAuth (leave blank to disable a provider - routes stay mounted but will
# 501 until keys are present, see controllers/auth.controller.ts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
